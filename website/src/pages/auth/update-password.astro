---
// Signed in, but not through a fresh reset link: use account settings instead
// (which asks for the current password).
if (!(await Astro.locals.auth.isRecoverySession())) {
  return Astro.redirect("/account");
}

import { UpdatePasswordForm } from "../../components/auth/UpdatePasswordForm";
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout title="Choose a new password">
  <Fragment slot="heading">Choose a new password</Fragment>
  <Fragment slot="subheading">Signed in as {Astro.locals.user?.email}</Fragment>

  <UpdatePasswordForm client:load />
</AuthLayout>
