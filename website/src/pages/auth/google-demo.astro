---
// Adapted from /common/legos/node/supabase-auth@1.0.0 (dvk-common d587e16), pages/auth/google-demo.astro. Owned by this project.
// Local auth only: stands in for Google's consent screen (auth.oauthUrl sends the visitor here).
import { OAuthDemoForm } from "~/components/auth-forms";
import { safeRedirectPath } from "~/components/auth-forms/validation";
import AuthLayout from "../../layouts/AuthLayout.astro";

if (!Astro.locals.auth.signInWithDemoOAuth) return new Response(null, { status: 404, statusText: "Not found" });
const redirectTo = safeRedirectPath(Astro.url.searchParams.get("next"), "/dashboard");
---

<AuthLayout title="Continue with Google (local)">
  <Fragment slot="heading">Continue with Google</Fragment>
  <Fragment slot="subheading">Local development: this page stands in for Google's sign-in.</Fragment>

  <OAuthDemoForm client:load redirectTo={redirectTo} />
</AuthLayout>
