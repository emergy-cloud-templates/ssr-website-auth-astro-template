---
import { SignUpForm } from "~/components/auth-forms";
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout title="Sign up">
  <Fragment slot="heading">Create your account</Fragment>
  <Fragment slot="subheading">
    Already have an account?{" "}
    <a href="/auth/signin" class="font-medium text-link hover:text-link-hover">
      Sign in
    </a>
  </Fragment>

  <SignUpForm client:load />
</AuthLayout>
