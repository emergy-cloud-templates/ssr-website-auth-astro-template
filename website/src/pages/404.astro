---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found">
  <main id="main" class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <p class="text-base font-semibold text-link">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight text-content sm:text-5xl">Page not found</h1>
    <p class="mt-6 text-base text-content-muted">Sorry, we could not find the page you are looking for.</p>
    <a
      href="/"
      class="mt-10 rounded-md bg-primary px-4 py-2.5 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary-hover"
    >
      Go back home
    </a>
  </main>
</Layout>
