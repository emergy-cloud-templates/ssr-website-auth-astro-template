---
import { siteConfig } from "../config/site";
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.user;

const features = [
  { title: "Server-side sessions", text: "httpOnly cookies, refreshed in middleware. No tokens in the browser." },
  { title: "Complete account flows", text: "Sign up, email confirmation, password reset, profile, deletion." },
  { title: "Runs anywhere", text: "Supabase in production, a zero-setup SQLite backend on your laptop." },
];
---

<Layout title="Home">
  <header class="bg-surface-raised shadow-sm">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8" aria-label="Main">
      <a href="/" class="text-xl font-bold text-link">
        {siteConfig.name}
      </a>
      <div class="flex items-center gap-4">
        {user ? (
          <>
            <a href="/dashboard" class="text-sm font-medium text-content-secondary hover:text-link">
              Dashboard
            </a>
            <a href="/account" class="text-sm font-medium text-content-secondary hover:text-link">
              Account
            </a>
          </>
        ) : (
          <>
            <a href="/auth/signin" class="text-sm font-medium text-content-secondary hover:text-link">
              Sign in
            </a>
            <a
              href="/auth/signup"
              class="rounded-md bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary-hover"
            >
              Get started
            </a>
          </>
        )}
      </div>
    </nav>
  </header>

  <main id="main" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-content sm:text-6xl">Welcome to {siteConfig.name}</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-content-muted">{siteConfig.description}</p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        {user ? (
          <a
            href="/dashboard"
            class="rounded-md bg-primary px-6 py-3 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary-hover"
          >
            Go to dashboard
          </a>
        ) : (
          <>
            <a
              href="/auth/signup"
              class="rounded-md bg-primary px-6 py-3 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary-hover"
            >
              Get started
            </a>
            <a href="/auth/signin" class="text-sm leading-6 font-semibold text-content">
              Sign in <span aria-hidden="true">&rarr;</span>
            </a>
          </>
        )}
      </div>
    </div>

    <ul class="mx-auto mt-20 grid max-w-5xl gap-6 sm:grid-cols-3">
      {features.map((feature) => (
        <li class="rounded-xl border border-line bg-surface-raised p-6 shadow-sm">
          <h2 class="font-semibold text-content">{feature.title}</h2>
          <p class="mt-2 text-sm text-content-muted">{feature.text}</p>
        </li>
      ))}
    </ul>
  </main>
</Layout>
