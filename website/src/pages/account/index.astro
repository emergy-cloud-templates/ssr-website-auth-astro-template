---
import { ChangePasswordForm } from "../../components/account/ChangePasswordForm";
import { DeleteAccountForm } from "../../components/account/DeleteAccountForm";
import { ProfileForm } from "../../components/account/ProfileForm";
import DashboardLayout from "../../layouts/DashboardLayout.astro";

const user = Astro.locals.user;
---

<DashboardLayout title="Account settings" pageTitle="Account settings">
  <div class="max-w-4xl space-y-8">
    <section
      class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
      aria-labelledby="profile-heading"
    >
      <div class="border-b border-gray-200 px-6 py-4">
        <h2 id="profile-heading" class="text-lg font-semibold text-gray-900">
          Profile
        </h2>
        <p class="mt-1 text-sm text-gray-600">Update your personal information.</p>
      </div>
      <div class="px-6 py-6">
        <ProfileForm client:load initialName={user?.name ?? ""} email={user?.email ?? ""} />
      </div>
    </section>

    <section
      class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
      aria-labelledby="password-heading"
    >
      <div class="border-b border-gray-200 px-6 py-4">
        <h2 id="password-heading" class="text-lg font-semibold text-gray-900">
          Change password
        </h2>
        <p class="mt-1 text-sm text-gray-600">Use a strong password you do not use anywhere else.</p>
      </div>
      <div class="px-6 py-6">
        <ChangePasswordForm client:load />
      </div>
    </section>

    <section
      class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm"
      aria-labelledby="danger-heading"
    >
      <div class="border-b border-red-200 bg-red-50 px-6 py-4">
        <h2 id="danger-heading" class="text-lg font-semibold text-red-700">
          Danger zone
        </h2>
        <p class="mt-1 text-sm text-red-700">Permanently delete your account and all associated data.</p>
      </div>
      <div class="px-6 py-6">
        <DeleteAccountForm client:load />
      </div>
    </section>
  </div>
</DashboardLayout>
