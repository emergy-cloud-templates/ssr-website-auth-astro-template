---
import { ChangePasswordForm, DeleteAccountForm, ProfileForm } from "~/components/auth-forms";
import DashboardLayout from "../../layouts/DashboardLayout.astro";

const user = Astro.locals.user;
---

<DashboardLayout title="Account settings" pageTitle="Account settings">
  <div class="max-w-4xl space-y-8">
    <section
      class="overflow-hidden rounded-xl border border-line bg-surface-raised shadow-sm"
      aria-labelledby="profile-heading"
    >
      <div class="border-b border-line px-6 py-4">
        <h2 id="profile-heading" class="text-lg font-semibold text-content">
          Profile
        </h2>
        <p class="mt-1 text-sm text-content-muted">Update your personal information.</p>
      </div>
      <div class="px-6 py-6">
        <ProfileForm client:load initialName={user?.name ?? ""} email={user?.email ?? ""} />
      </div>
    </section>

    <section
      class="overflow-hidden rounded-xl border border-line bg-surface-raised shadow-sm"
      aria-labelledby="password-heading"
    >
      <div class="border-b border-line px-6 py-4">
        <h2 id="password-heading" class="text-lg font-semibold text-content">
          Change password
        </h2>
        <p class="mt-1 text-sm text-content-muted">Use a strong password you do not use anywhere else.</p>
      </div>
      <div class="px-6 py-6">
        <ChangePasswordForm client:load />
      </div>
    </section>

    <section
      class="overflow-hidden rounded-xl border border-status-error/30 bg-surface-raised shadow-sm"
      aria-labelledby="danger-heading"
    >
      <div class="border-b border-status-error/30 bg-status-error-bg px-6 py-4">
        <h2 id="danger-heading" class="text-lg font-semibold text-status-error-content">
          Danger zone
        </h2>
        <p class="mt-1 text-sm text-status-error-content">Permanently delete your account and all associated data.</p>
      </div>
      <div class="px-6 py-6">
        <DeleteAccountForm client:load />
      </div>
    </section>
  </div>
</DashboardLayout>
