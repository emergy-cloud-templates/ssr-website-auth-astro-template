---
import AppShell from "~/components/app-shell/AppShell.astro";
import type { NavEntry } from "~/components/app-shell";
import { siteConfig } from "../config/site";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  pageTitle?: string;
}

/** The dashboard's navigation (the app-shell lego renders it): add your app's sections here. */
const NAV: NavEntry[] = [
  { label: "Dashboard", href: "/dashboard", icon: "home", match: "exact" },
  { label: "Settings", href: "/account", icon: "cog" },
];

const { title, pageTitle } = Astro.props;
const user = Astro.locals.user;
---

<Layout title={title} skipLink={false}>
  <AppShell
    brand={{ name: siteConfig.name, href: "/dashboard" }}
    nav={NAV}
    user={user}
    title={pageTitle}
    sidebarLabels={{ closeMenu: "Close navigation" }}
    headerLabels={{ openMenu: "Open navigation", showNavigation: "Expand sidebar", hideNavigation: "Collapse sidebar" }}
  >
    <slot />
  </AppShell>
</Layout>
