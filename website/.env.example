# -----------------------------------------------------------------------------
# Local configuration. Copy to `.env` (never commit it):  cp .env.example .env
#
# With NOTHING set, the app runs in local auth mode: users, sessions and
# emails live in a SQLite file (.data/local-auth.sqlite). No account needed.
# In AWS these values come from the "<env>/<project_id>" Secrets Manager
# secret instead (see docs/configuration.md).
# -----------------------------------------------------------------------------

# Which auth backend to use: "supabase" or "local".
# Default: "supabase" when the two Supabase values below are set, else "local".
# AUTH_PROVIDER=local

# --- Supabase (Project Settings > API) -------------------------------------
# Hosted project:            https://<project-ref>.supabase.co
# Local stack (supabase start): http://127.0.0.1:54321
# PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy "anon" key also works, as
# PUBLIC_SUPABASE_ANON_KEY.
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY. Only
# needed for "Delete account". Never prefix it with PUBLIC_.
# SUPABASE_SECRET_KEY=

# --- Links in emails ---------------------------------------------------------
# Public origin used in confirmation and password-reset links.
# Default: the origin of the incoming request.
# SITE_URL=http://localhost:4321

# --- Local auth provider -----------------------------------------------------
# LOCAL_AUTH_DB_PATH=.data/local-auth.sqlite
# Require clicking the emailed link before the first sign-in (like Supabase's
# "Confirm email" setting). Links appear at http://localhost:4321/dev/mailbox
# LOCAL_AUTH_REQUIRE_EMAIL_CONFIRMATION=false
