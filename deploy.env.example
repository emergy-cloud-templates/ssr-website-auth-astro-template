# Configuration for scripts/deploy.sh. Copy to deploy.env (gitignored).
# No secrets here: AWS credentials come from your AWS CLI login, and app
# secrets live in Secrets Manager ("<env>/<project_id>").

AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
PROJECT_ID=my-project
ENVS=dev,prod

# Terraform state: same values as the TF_BACKEND_BUCKET / TF_STATE_KEY_PREFIX
# repository variables, so local runs and CI share one state.
TF_BACKEND_BUCKET=my-project-tfstate-123456789012
TF_STATE_KEY_PREFIX=my-project

# Optional custom domains: same names as the repository variables
# (see docs/configuration.md).
# AWS_WEBSITE_ACM_NAME=example.com
# AWS_WEBSITE_ACM_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...
# HOSTNAME_PROD=app.example.com
