{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm test:ssr)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm verify)",
      "Bash(pnpm build)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate)",
      "Bash(terraform test)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./deploy.env)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfvars)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
